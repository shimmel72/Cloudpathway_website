# /etc/cloudpathway-web/env — the website's settings, read by systemd as root.
#
# Mode 600, owned by root: it holds the Telnyx key. The service account never
# reads this file; systemd hands the values to the process.
#
# Single quotes: systemd takes them verbatim (no escapes, no $ expansion).
# After editing:  sudo systemctl restart cloudpathway-web
#
# `install.sh install --import-phonesystem-env` fills the first three from the
# phone system's server/.env, if it lives on this machine.

# The same key the phone system uses for numbers and SMS.
TELNYX_API_KEY=''

# An address on a domain verified under Email -> Domains in the Telnyx portal.
# Telnyx refuses anything else. Example: 'Cloudpathway <no-reply@cloudpathway.org>'
MAIL_FROM=''

# The phone system portal's public https:// address. Puts the "Import into the
# portal" button in reseller application emails.
PORTAL_URL=''

# Where reseller applications are emailed.
RESELLER_APPLICATION_TO='12shimmel@gmail.com'
