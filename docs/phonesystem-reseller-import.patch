+/**
+ * The fields an outside application is allowed to fill in.
+ *
+ * A whitelist, not a spread. The commercial terms -- reseller_plan_id,
+ * wholesale_discount_pct, margin_cents -- are picked with the reseller and
+ * must never arrive in a link, or a crafted URL becomes a way to propose your
+ * own margin and have somebody save it without looking. Same reason there is
+ * no admin_password here: a credential does not belong in a URL.
+ */
+const IMPORTABLE = [
+  'name', 'slug', 'brand_name', 'support_email', 'support_phone',
+  'admin_name', 'admin_email',
+] as const;
+
+/** `?import=` from the website's reseller application email, or null. */
+function decodeImport(token: string | null): Record<string, string> | null {
+  if (!token) return null;
+  try {
+    const json = atob(token.replace(/-/g, '+').replace(/_/g, '/'));
+    const raw = JSON.parse(decodeURIComponent(escape(json))) as Record<string, unknown>;
+    const out: Record<string, string> = {};
+    for (const key of IMPORTABLE) {
+      if (typeof raw[key] === 'string' && raw[key]) out[key] = raw[key] as string;
+    }
+    return out.name ? out : null;
+  } catch {
+    // A truncated or mangled link should open an empty form, not a crash.
+    return null;
+  }
+}
